import Mock from 'mockjs'


Mock.mock('/api/getUser','get',{
  code:200,
  msg:'请求成功',
  data:{
    name:"王浩宇",
    age:18
  }
})

Mock.mock('/api/login','post',function(option){
  let params = JSON.parse(option.body)
  if(params.username === "admin" && params.password === "123456"){
    return {
      code:200,
      msg:"登录成功",
      token:"abcd123456"
    }
  }else{
    return {
      code:400,
      msg:"账号密码错误"
    }
  }
})

Mock.setup({
  timeout:300
})
